{
  "Urls": "http://0.0.0.0:8080",
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Ingest": "Host=localhost;Port=5432;Database=analytics;Username=analytics_ingest;Password=change-me"
  },
  "Ingest": {
    "EnforceOrigin": true,
    "TrustedProxies": [],
    "QueueCapacity": 10000,
    "MaxBatchSize": 500,
    "FlushIntervalMs": 1000,
    "RateLimitPerMinute": 120,
    "DataDir": "data",
    "GeoRefreshHours": 24,
    "SiteRefreshSeconds": 30,
    "IdentitySecret": ""
  }
}
